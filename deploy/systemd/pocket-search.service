[Unit]
Description=Pocket Search — watch web pages for changes
After=network-online.target
Wants=network-online.target

[Service]
User=pocket-search
Group=pocket-search
ExecStart=/usr/local/bin/pocket-search
Environment=DATA_DIR=/var/lib/pocket-search
Environment=PORT=8080
Environment=BASE_URL=https://search.example.com
Environment=SECURE_COOKIES=true
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pocket-search
PrivateTmp=true

[Install]
WantedBy=multi-user.target
